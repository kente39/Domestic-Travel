# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤, 실제 키 값을 채워 넣으세요.
#   cp .env.example .env
#
# .env 파일은 절대 Git에 커밋하거나 제출물에 포함하지 마세요. (.gitignore에 추가 권장)

# Anthropic Claude API 키
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=여기에_발급받은_키를_입력하세요

# Kakao REST API 키 (Kakao Local API용)
# 발급: https://developers.kakao.com -> 내 애플리케이션 -> 앱 키 -> REST API 키
KAKAO_REST_API_KEY=여기에_발급받은_키를_입력하세요

# (선택) 사용할 Anthropic 모델을 바꾸고 싶다면 주석을 해제하세요.
# 사용 가능한 모델 목록: https://docs.claude.com/en/docs/about-claude/models
# ANTHROPIC_MODEL=claude-sonnet-5
